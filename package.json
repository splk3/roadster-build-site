{
  "name": "roadster-build-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "import": "node scripts/import-wordpress.mjs",
    "build": "eleventy",
    "dev": "eleventy --serve",
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-site.mjs && node scripts/validate-workflows.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint . && stylelint 'src/assets/css/*.css' && prettier --check .",
    "format": "prettier --write .",
    "lint:super": "bash scripts/super-linter.sh"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/json": "2.1.1",
    "@playwright/test": "1.65.0",
    "@wordpress/autop": "5.1.0",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "fast-xml-parser": "5.12.0",
    "html-validate": "11.19.0",
    "prettier": "3.9.10",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "yaml": "2.9.1"
  }
}
