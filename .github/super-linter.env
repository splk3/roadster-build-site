VALIDATE_ALL_CODEBASE=true
USE_FIND_ALGORITHM=true
LINTER_RULES_PATH=.github/linters
JAVASCRIPT_ES_CONFIG_FILE=eslint.config.mjs
VALIDATE_JAVASCRIPT_ES=true
VALIDATE_JAVASCRIPT_PRETTIER=true
VALIDATE_CSS=true
VALIDATE_CSS_PRETTIER=true
VALIDATE_JSON=true
VALIDATE_JSON_PRETTIER=true
VALIDATE_MARKDOWN=true
VALIDATE_MARKDOWN_PRETTIER=true
VALIDATE_YAML=true
VALIDATE_YAML_PRETTIER=true
VALIDATE_GITHUB_ACTIONS=true
VALIDATE_BASH=true
VALIDATE_BASH_EXEC=true
MULTI_STATUS=false
IGNORE_GITIGNORED_FILES=true
STRIP_DEFAULT_WORKSPACE_FOR_REGEX=true
FILTER_REGEX_EXCLUDE=^(\.git|tmp|node_modules|_site|test-results|playwright-report|super-linter-output)/
