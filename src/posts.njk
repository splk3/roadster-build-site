---
layout: layout.njk
pagination:
  data: archive.posts
  size: 1
  alias: post
permalink: "{{ post.url }}"
eleventyComputed:
  title: "{{ post.title }}"
  description: "{{ post.description }}"
---
<article>
  <h1>{{ post.title | escape }}</h1>
  <p class="metadata">Posted on <time datetime="{{ post.date }}">{{ post.date | readableDate }}</time> by {{ post.author | escape }}</p>
  <div class="entry-content">{{ post.html | safe }}</div>
  {% include "terms.njk" %}
  {% if post.comments.length %}
  <section id="comments" aria-labelledby="comments-title">
    <h2 id="comments-title">{{ post.comments.length }} historical comment{% if post.comments.length != 1 %}s{% endif %}</h2>
    <p>Comments are closed. These comments are preserved from the original site.</p>
    {% for comment in post.comments %}
    <article class="comment{% if comment.parent %} comment-reply{% endif %}" id="comment-{{ comment.id }}">
      <h3>{{ comment.author | escape }}</h3>
      <p class="metadata"><time datetime="{{ comment.date }}">{{ comment.date | readableDate }} at {{ comment.date.slice(11, 16) }}</time>{% if comment.parent %} · <a href="#comment-{{ comment.parent }}">In reply to an earlier comment</a>{% endif %}</p>
      <div class="entry-content">{{ comment.html | safe }}</div>
    </article>
    {% endfor %}
  </section>
  {% endif %}
</article>
<nav class="pagination" aria-label="Adjacent posts">
  {% if post.older %}<a href="{{ post.older }}">← Older post</a>{% endif %}
  {% if post.newer %}<a href="{{ post.newer }}">Newer post →</a>{% endif %}
</nav>
