---
layout: layout.njk
pagination:
  data: archive.pages
  size: 1
  alias: article
permalink: "{{ article.url }}"
eleventyComputed:
  title: "{{ article.title }}"
  description: "{{ article.description }}"
---
<article class="single-post static-page">
  <header class="article-header">
    <h1>{{ article.title | escape }}</h1>
  </header>
  <div class="entry-content">{{ article.html | safe }}</div>
</article>
