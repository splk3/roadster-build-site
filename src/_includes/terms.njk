{% if post.categories.length or post.tags.length %}
<div class="post-terms">
  {% if post.categories.length %}
  <ul class="term-chip-list">
    {% for term in post.categories %}
    <li><a class="term-chip" href="{{ term.url }}">{{ term.title | escape }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if post.tags.length %}
  <ul class="term-chip-list term-chip-list-tags">
    {% for term in post.tags %}
    <li><a class="term-chip term-chip-tag" href="{{ term.url }}">#{{ term.title | escape }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}
