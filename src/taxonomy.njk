---
layout: layout.njk
pagination:
  data: archive.terms
  size: 1
  alias: term
permalink: "{{ term.url }}"
eleventyComputed:
  title: "{{ term.title }}"
---
<header class="archive-header">
  <p class="archive-kicker">{{ "Category" if term.taxonomy == "category" else "Tag" }}</p>
  <h1>{{ term.title | escape }}</h1>
  <p class="archive-lead">{{ term.posts.length }} archived post{% if term.posts.length != 1 %}s{% endif %} · <a href="/topics/">Browse all topics</a></p>
</header>
<div class="post-feed">
  {% for url in term.posts %}{% set post = archive.posts | findPost(url) %}{% include "post-summary.njk" %}{% endfor %}
</div>
