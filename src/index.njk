---
layout: layout.njk
pagination:
  data: archive.home
  size: 1
  alias: listing
permalink: "{{ listing.url }}"
---
<h1 class="visually-hidden">Posts{% if listing.number > 1 %}, page {{ listing.number }}{% endif %}</h1>
{% for post in listing.posts %}{% include "post-summary.njk" %}{% endfor %}
<nav class="pagination" aria-label="Posts pagination">
  {% if listing.previous %}<a href="{{ listing.previous }}">← Newer posts</a>{% endif %}
  <span>Page {{ listing.number }} of {{ archive.home.length }}</span>
  {% if listing.next %}<a href="{{ listing.next }}">Older posts →</a>{% endif %}
</nav>
{% if listing.number == 1 %}
<script>
  (() => {
    const postId = new URLSearchParams(window.location.search).get("p");
    if (!postId || !/^\d+$/.test(postId)) return;

    fetch("/search-index.json")
      .then((res) => {
        if (!res.ok) throw new Error(`Search index request failed (${res.status})`);
        return res.json();
      })
      .then((posts) => {
        const match = posts.find((post) => String(post.id) === postId);
        if (match) window.location.replace(match.url);
      })
      .catch((error) => console.error("Legacy post lookup unavailable", error));
  })();
</script>
{% endif %}
